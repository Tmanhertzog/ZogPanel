{
  "manifest_version": 3,
  "name": "ZogPanel",
  "version": "0.8.0",
  "description": "Personal dashboard that opens once when Chrome starts: bookmarks, shortcuts, tasks, projects and news.",
  "permissions": ["bookmarks", "topSites", "tabs", "storage", "favicon"],
  "host_permissions": ["https://api.notion.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open ZogPanel",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
