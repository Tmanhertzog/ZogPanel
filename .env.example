# ZogPanel configuration
# Copy this file to ".env" in the same folder, fill in your values,
# then reload the extension in chrome://extensions.
# .env is git-ignored, so your keys never end up on GitHub.

# ---------- You ----------
# Name used in the greeting ("Good morning, <name>")
USER_NAME=

# Theme used until you pick one: basic | motivated | chill
DEFAULT_THEME=basic

# Search engine. The search text is appended to the end.
SEARCH_URL=https://www.google.com/search?q=

# ---------- Themes ----------
# Folder (inside the extension folder) with background photos for the Basic theme.
# After adding or removing photos, run update-images.ps1 to rebuild its images.json.
BACKGROUND_IMAGES_DIR=basic_bkg_images

# Quote shown on the Motivated theme
MOTIVATED_QUOTE="Impossible is a word to be found only in the dictionary of fools."
MOTIVATED_QUOTE_AUTHOR=Napoleon Bonaparte

# ---------- Shortcuts ----------
MAX_SHORTCUTS=24

# ---------- Notion ----------
# Internal integration token from https://www.notion.so/my-integrations
# (Share your ZogPanel page with the integration: ••• › Connections.)
# You can also paste it in the dashboard's Settings instead; Settings wins if both are set.
NOTION_TOKEN=
NOTION_VERSION=2025-09-03

# Data source IDs of your databases. In Notion: open the database ›
# ••• › "Copy link to data source" (or see README for how to find them).
NOTION_SHORTCUTS_DS=
NOTION_TASKS_DS=
NOTION_PROJECTS_DS=
NOTION_NEWS_TOPICS_DS=

# ---------- AI assistant ----------
# Which AI turns your chat messages into Notion changes: openai | gemini
AI_PROVIDER=openai

# OpenAI: key from https://platform.openai.com/api-keys (needs prepaid billing)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano

# Google Gemini: key from https://aistudio.google.com/apikey
# Flash-Lite has a free tier, but Google may use free-tier prompts to improve its products.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
